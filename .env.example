# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/placement_portal

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# App
CLIENT_URL=http://localhost:5173

# SMTP (Gmail App Password works fine for a demo — see README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=Placement Portal <youraddress@gmail.com>
